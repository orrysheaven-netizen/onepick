/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co https://image.tmdb.org https://images.igdb.com https://coverartarchive.org https://i.ytimg.com https://*.ytimg.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin

# Ask search engines not to index the test host or its preview deployments.
# This is not authentication; anyone with the URL can still open the site.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
  Cache-Control: no-store, max-age=0

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
  Cache-Control: no-store, max-age=0
