EXPO_PUBLIC_SUPABASE_URL=https://ygoipwzakzdnkaaxyrgb.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Optional canonical HTTPS web origin, e.g. https://onepick.example (no subpath).
# When omitted, web shares use the current origin; native shares use onepick://.
EXPO_PUBLIC_SHARE_BASE_URL=

# Native/EAS identity: leave empty until confirmed by the account owner.
# These identifiers are public metadata, not credentials. Web builds do not need them.
# Use the same confirmed values locally and in the EAS preview environment.
ONEPICK_IOS_BUNDLE_IDENTIFIER=
ONEPICK_ANDROID_PACKAGE=
ONEPICK_EXPO_OWNER=
ONEPICK_EAS_PROJECT_ID=
